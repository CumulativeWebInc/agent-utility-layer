{
  "name": "mem_long_term",
  "provisional": true,
  "pillar": "memory",
  "version": "0.1.0",
  "description": "Durable namespaced memory with importance scoring and tags. The persistent fact store memory_sync composes.",
  "permissions": [
    "memory:long_term"
  ],
  "inputs_schema": {
    "type": "object",
    "properties": {
      "op": {
        "type": "string",
        "description": "Operation to perform.",
        "enum": [
          "remember",
          "recall",
          "query",
          "forget",
          "namespaces"
        ]
      },
      "namespace": {
        "type": "string"
      },
      "key": {
        "type": "string"
      },
      "value": {},
      "importance": {
        "type": "number",
        "default": 0.5
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "tag": {
        "type": "string"
      },
      "min_importance": {
        "type": "number"
      }
    },
    "required": [
      "op"
    ]
  },
  "outputs_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "found": {
        "type": "boolean"
      },
      "value": {},
      "entries": {
        "type": "array"
      },
      "namespaces": {
        "type": "array"
      }
    }
  },
  "setup_price_usd": 1.0,
  "price_per_execution_usd": 0.001,
  "provider_notes": "sqlite3 via stdlib; store dir from ctx.store_dir, $AUL_STORE_DIR, or ~/.aul/data."
}