{
  "name": "retry_policy",
  "provisional": true,
  "pillar": "agent_infra",
  "version": "0.1.0",
  "description": "Retry math (linear/exponential backoff + jitter) plus a dead-letter store for exhausted operations.",
  "permissions": [
    "agent:retry_policy"
  ],
  "inputs_schema": {
    "type": "object",
    "properties": {
      "op": {
        "type": "string",
        "description": "Operation to perform.",
        "enum": [
          "plan",
          "next_delay",
          "record_failure",
          "dead_letter",
          "requeue"
        ]
      },
      "policy": {
        "type": "object"
      },
      "attempt": {
        "type": "integer"
      },
      "operation_id": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    },
    "required": [
      "op"
    ]
  },
  "outputs_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "delays": {
        "type": "array"
      },
      "delay_seconds": {
        "type": "number"
      },
      "attempts": {
        "type": "integer"
      },
      "dead_lettered": {
        "type": "boolean"
      },
      "entries": {
        "type": "array"
      }
    }
  },
  "setup_price_usd": 1.0,
  "price_per_execution_usd": 0.001,
  "provider_notes": "Pure-Python backoff math; dead-letter in sqlite."
}