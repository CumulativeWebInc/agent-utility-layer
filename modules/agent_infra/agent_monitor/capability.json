{
  "name": "agent_monitor",
  "provisional": true,
  "pillar": "agent_infra",
  "version": "0.1.0",
  "description": "Agent heartbeat registry with staleness detection.",
  "permissions": [
    "agent:monitor"
  ],
  "inputs_schema": {
    "type": "object",
    "properties": {
      "op": {
        "type": "string",
        "description": "Operation to perform.",
        "enum": [
          "heartbeat",
          "status",
          "list",
          "deregister"
        ]
      },
      "agent": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "metrics": {
        "type": "object"
      },
      "stale_after_s": {
        "type": "number",
        "default": 300
      }
    },
    "required": [
      "op"
    ]
  },
  "outputs_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "agent": {
        "type": "string"
      },
      "agent_status": {
        "type": "string"
      },
      "last_heartbeat": {
        "type": "number"
      },
      "stale": {
        "type": "boolean"
      },
      "agents": {
        "type": "array"
      }
    }
  },
  "setup_price_usd": 1.0,
  "price_per_execution_usd": 0.001,
  "provider_notes": "sqlite3 via stdlib; store dir from ctx.store_dir, $AUL_STORE_DIR, or ~/.aul/data."
}