{
  "name": "send_push",
  "provisional": true,
  "pillar": "communication",
  "version": "0.1.0",
  "description": "Deliver a push notification through a generic provider HTTP hook.",
  "permissions": [
    "push:send"
  ],
  "inputs_schema": {
    "type": "object",
    "properties": {
      "target": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "body": {
        "type": "string",
        "minLength": 1
      },
      "data": {
        "type": "object"
      }
    },
    "required": [
      "target",
      "title",
      "body"
    ]
  },
  "outputs_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "receipt": {
        "type": "string"
      }
    }
  },
  "setup_price_usd": 1.0,
  "price_per_execution_usd": 0.001,
  "provider_notes": "Generic provider POST via stdlib urllib; credentials from ctx.auth_get('push') as JSON {endpoint_url, api_key, auth_scheme}. Map to FCM / OneSignal / ntfy by setting endpoint_url."
}
